import types
from _typeshed import Incomplete
from enum import IntEnum
from typing import Any, Callable

__all__ = ['LogLevel', 'LogRecord', 'Logger', 'get_logger', 'dump']

class LogLevel(IntEnum):
    VERBOSE = 2
    DEBUG = 3
    INFO = 4
    WARNING = 5
    ERROR = 6
    OFF = 100

class LogRecord:
    level: Incomplete
    tag: Incomplete
    message: Incomplete
    location: Incomplete
    traceback: Incomplete
    created: Incomplete
    def __init__(self, level: LogLevel, tag: str, message: str, location: str | None, tb: str | None, created: float) -> None: ...
    @property
    def text(self) -> str: ...

class _Timer:
    def __init__(self, logger: Logger, label: str, level: LogLevel) -> None: ...
    def __enter__(self): ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: types.TracebackType | None): ...

class Logger:
    def __init__(self, tag: str, *, show_location: bool = True) -> None: ...
    @property
    def tag(self) -> str: ...
    @property
    def level(self) -> LogLevel | None: ...
    @level.setter
    def level(self, value: LogLevel | int | str | None): ...
    @property
    def effective_level(self) -> LogLevel: ...
    def is_enabled_for(self, level: LogLevel | int | str) -> bool: ...
    def child(self, name: str) -> Logger: ...
    def verbose(self, msg: Any, *args, exc_info: Any = None, stacklevel: int = 1) -> None: ...
    def debug(self, msg: Any, *args, exc_info: Any = None, stacklevel: int = 1) -> None: ...
    def info(self, msg: Any, *args, exc_info: Any = None, stacklevel: int = 1) -> None: ...
    def warning(self, msg: Any, *args, exc_info: Any = None, stacklevel: int = 1) -> None: ...
    def error(self, msg: Any, *args, exc_info: Any = None, stacklevel: int = 1) -> None: ...
    def exception(self, msg: Any, *args, stacklevel: int = 1) -> None: ...
    def log(self, level: LogLevel | int | str, msg: Any, *args, exc_info: Any = None, stacklevel: int = 1) -> None: ...
    def dump(self, obj: Any, label: str | None = None, *, level: LogLevel | int | str = ..., depth: int = 2, max_items: int = 20, stacklevel: int = 1) -> None: ...
    def timed(self, label: str, level: LogLevel | int | str = ...) -> _Timer: ...
    def add_handler(self, handler: Callable[[LogRecord], Any]) -> None: ...
    def remove_handler(self, handler: Callable[[LogRecord], Any]) -> bool: ...

def get_logger(name: str | None = None) -> Logger: ...

class _Unreadable:
    error: Incomplete
    def __init__(self, error: BaseException) -> None: ...

class _Dumper:
    def __init__(self, depth: int, max_items: int) -> None: ...
    def render(self, obj: Any) -> str: ...

def dump(obj: Any, depth: int = 2, max_items: int = 20) -> str: ...
